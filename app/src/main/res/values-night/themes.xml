<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.skinwise" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/lighter</item>
        <item name="colorPrimaryVariant">@color/darker</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="21">?attr/colorPrimaryVariant</item>
        <item name="android:textColorHint">@color/darker</item>
        <item name="android:textColorHighlight">@color/main</item>
        <item name="android:textCursorDrawable">@drawable/ic_cursor</item>
        <item name="android:textSelectHandle">@drawable/ic_cursor_pointer</item>
        <item name="android:textSelectHandleLeft">@drawable/ic_cursor_pointer</item>
        <item name="android:textSelectHandleRight">@drawable/ic_cursor_pointer</item>

    </style>
</resources>