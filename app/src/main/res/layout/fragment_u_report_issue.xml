<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".User.UReportIssue">



    <RelativeLayout
        android:id="@+id/Rlayout2"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        >

        <ImageButton
            android:id="@+id/backbtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="30dp"
            android:layout_centerVertical="true"
            android:background="@null"
            android:src="@drawable/ic_back"/>
        <TextView
            android:id="@+id/bacttxt"
            android:textColor="@color/darker"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_centerVertical="true"
            android:layout_alignStart="@+id/backbtn"
            android:text="@string/Back"/>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        android:padding="40dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/darker"
            android:text="Report an Issue"
            android:layout_gravity="center_horizontal"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/editTextIssueDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describe the issue"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:maxLines="6"
            android:layout_marginBottom="16dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/imageContainer"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:orientation="horizontal" />
        </HorizontalScrollView>


        <Button
            android:id="@+id/buttonAttachScreenshot"
            android:layout_width="match_parent"
            app:backgroundTint="@null"
            android:textColor="@color/darker"
            android:textAllCaps="false"
            android:background="@drawable/shape_btnborder_darker"
            android:layout_height="wrap_content"
            android:text="Select Images (Max 3, Optional)"
            android:layout_marginBottom="16dp"/>


        <EditText
            android:id="@+id/editTextContactInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contact Information (Optional)"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"/>


        <Button
            android:id="@+id/submitissuebutton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_cornerlighter"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/passwordhint2"
            android:layout_marginTop="35dp"
            app:backgroundTint="@null"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:text="Submit Issue"/>

    </LinearLayout>
</FrameLayout>