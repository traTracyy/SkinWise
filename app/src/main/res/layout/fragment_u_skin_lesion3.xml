<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".User.USkinLesion">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context="User.USetting">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_height="wrap_content">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/Rlayout2"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    >

                    <ImageButton
                        android:id="@+id/backbtn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:background="@null"
                        android:src="@drawable/ic_back"/>
                    <TextView
                        android:id="@+id/bacttxt"
                        android:textColor="@color/darker"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_centerVertical="true"
                        android:layout_alignStart="@+id/backbtn"
                        android:text="@string/Back"/>

                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:id="@+id/bookmark"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="100dp"
                    android:layout_height="wrap_content">
                    <ImageButton
                        android:background="@null"
                        android:layout_width="35dp"
                        android:layout_toStartOf="@+id/filtertxt"
                        android:layout_height="35dp"
                        android:scaleType="fitXY"
                        android:id="@+id/bookmarkic"
                        android:src="@drawable/ic_bookmark_remove" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_toEndOf="@id/bookmarkic"
                        android:text="Remove Bookmark"
                        android:textColor="@color/darker"
                        android:textStyle="bold" />
                </RelativeLayout>

            </LinearLayout>

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/round_corner3"
                android:id="@+id/skinlesionImg"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/skintype"
                android:textColor="@color/darker"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textSize="30dp"
                android:text="LesionType"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/second"
                android:id="@+id/overviewtxt"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textSize="25dp"
                android:text="Overview"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:id="@+id/overview"
                android:layout_marginTop="10dp"
                android:textSize="15dp"
                android:text="Overview"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/second"
                android:id="@+id/Symptomstxt"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textSize="25dp"
                android:text="Symptoms"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:id="@+id/symptoms"
                android:layout_marginTop="10dp"
                android:textSize="15dp"
                android:text="Symptoms"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/second"
                android:id="@+id/Typicaltxt"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textSize="25dp"
                android:text="Cause"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:id="@+id/typical"
                android:layout_marginTop="10dp"
                android:textSize="15dp"
                android:text="Cause"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C9201B1B"
                android:textStyle="italic"
                android:layout_gravity="center_horizontal"
                android:id="@+id/copyright"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="90dp"
                android:textSize="15dp"
                android:text="copyright"/>
        </LinearLayout>


    </FrameLayout>

</ScrollView>