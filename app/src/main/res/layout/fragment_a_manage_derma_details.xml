<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginBottom="90dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".Admin.AManageDermaDetails">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="30dp"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/Rlayout2"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                >

                <ImageButton
                    android:id="@+id/backbtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:background="@null"
                    android:src="@drawable/ic_back"/>
                <TextView
                    android:id="@+id/bacttxt"
                    android:textColor="@color/darker"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:layout_alignStart="@+id/backbtn"
                    android:text="@string/Back"/>

            </RelativeLayout>
            <com.blogspot.atifsoftwares.circularimageview.CircularImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_profile"
                app:c_border="true"
                app:c_border_color="@color/darker"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                app:c_border_width="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textStyle="bold"
                    android:textSize="@dimen/_14sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="Clinic Name:\t\t"/>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="@dimen/_14sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="Clinic Name"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textStyle="bold"
                    android:textSize="@dimen/_14sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="Email:\t\t"/>

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"                    android:textSize="@dimen/_14sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="Email"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/Number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textStyle="bold"
                    android:textSize="@dimen/_14sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="Phone Number:\t\t"/>

                <TextView
                    android:id="@+id/tvPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="@dimen/_14sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="Phone Number"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textStyle="bold"
                    android:textSize="@dimen/_14sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="State:\t\t"/>

                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="@dimen/_14sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="State"/>
            </LinearLayout>


            <Button
                android:id="@+id/btnApprove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:backgroundTint="@null"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/round_cornerlighter"
                android:textAllCaps="false"
                android:text="Approve Request"/>
            <Button
                android:id="@+id/deleteUserButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/round_corner3"
                android:layout_centerHorizontal="true"
                android:textAllCaps="false"
                android:layout_gravity="center_horizontal"
                android:layout_below="@+id/passwordhint2"
                android:layout_marginTop="25dp"
                app:backgroundTint="@null"
                android:textStyle="bold"
                android:textColor="@color/darker"
                android:text="Reject Request"/>
        </LinearLayout>

    </FrameLayout>

</ScrollView>