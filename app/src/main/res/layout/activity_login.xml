<!--            android:layout_height="wrap_content"-->
<!--            android:textColor="@color/darker"-->
<!--            android:textAlignment="center"-->
<!--            android:text="@string/Email"/>-->

        <!--        <TextView-->
<!--            android:id="@+id/passwordtxt"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:textAlignment="center"-->
<!--            android:textColor="@color/darker"-->
<!--            android:layout_marginTop="18dp"-->
<!--            android:layout_below="@id/emailhint"-->
<!--            android:text="@string/Password1"/>-->

        <EditText
            android:id="@+id/emailhint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/emailtxt"
            android:background="@drawable/round_corner3"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="15dp"
            android:hint="@string/emailhint"
            android:inputType="textEmailAddress"
            android:textSize="12dp"
            android:padding="8dp"
            android:textColor="@color/darker"
            android:textColorHint="@color/darker" />

        <EditText
            android:id="@+id/passwordhint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:drawableStart="@drawable/ic_locker"
            android:textSize="12dp"
            android:drawablePadding="15dp"
            android:hint="@string/passwordhint"
            android:textColor="@color/darker"
            android:textColorHint="@color/darker"
            android:layout_marginTop="18dp"
            android:layout_below="@+id/emailhint"
            android:layout_centerHorizontal="true"
            android:inputType="textPassword"
            android:padding="8dp" />

<!--        <TextView-->
<!--            android:id="@+id/passwordtxt2"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:textColor="@color/darker"-->
<!--            android:textAlignment="center"-->
<!--            android:layout_marginTop="18dp"-->
<!--            android:layout_below="@id/passwordhint"-->
<!--            android:text="@string/Password2"/>-->

        <EditText
            android:id="@+id/passwordhint2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:drawableStart="@drawable/ic_password"
            android:drawablePadding="15dp"
            android:hint="@string/passwordhint2"
            android:layout_centerHorizontal="true"
            android:textColor="@color/darker"
            android:textColorHint="@color/darker"
            android:textSize="12dp"
            android:layout_marginTop="18dp"
            android:layout_below="@+id/passwordhint"
            android:inputType="textPassword"
            android:padding="8dp" />
        <TextView
            android:id="@+id/forgotpassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12dp"
            android:textColor="@color/second"
            android:textAlignment="center"
            android:layout_marginTop="18dp"
            android:layout_below="@id/passwordhint2"
            android:text="@string/forgotpassword"/>

        <Button
            android:id="@+id/loginbtn"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_below="@+id/forgotpassword"
            android:layout_centerInParent="true"
            android:layout_marginTop="20dp"
            android:background="@drawable/round_cornerlighter"
            android:text="@string/Login"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/registerdermtxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_alignTop="@+id/registeruser"
            android:layout_marginTop="35dp"
            android:textStyle="bold"
            android:textColor="@color/second"
            android:layout_centerHorizontal="true"
            android:text="@string/Registerdermaacc" />

        <TextView
            android:id="@+id/registeruser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="35dp"
            android:text="@string/Registeruseracc"
            android:layout_below="@+id/loginbtn"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>



</RelativeLayout>

