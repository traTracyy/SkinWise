<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="90dp">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".Admin.AFeedbackDetails">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:padding="30dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/Rlayout2"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                >

                <ImageButton
                    android:id="@+id/backbtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:background="@null"
                    android:src="@drawable/ic_back"/>
                <TextView
                    android:id="@+id/bacttxt"
                    android:textColor="@color/darker"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:layout_alignStart="@+id/backbtn"
                    android:text="@string/Back"/>

            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/userid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="16sp"
                    android:text="User ID:\t\t"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />
                <TextView
                    android:id="@+id/UserId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="16sp"
                    android:text="User ID"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/reportIdtv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:text="Report ID:\t\t"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />
                <TextView
                    android:id="@+id/reportId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="16sp"
                    android:text="Report ID"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/dateTimetv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="16sp"
                    android:text="Date Time:\t\t"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />
                <TextView
                    android:id="@+id/dateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="16sp"
                    android:text="dateTime"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/contactInfotv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="Contact Information:\t\t"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />
                <TextView
                    android:id="@+id/contactInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="16sp"
                    android:text="contact"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/descriptiontv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:layout_gravity="center_vertical"
                    android:textSize="16sp"
                    android:text="Description:\t\t"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />
                <TextView
                    android:id="@+id/description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darker"
                    android:textSize="16sp"
                    android:text="descriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescriptiondescription"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/darker"
                android:textSize="16sp"
                android:textStyle="bold"
                android:id="@+id/image"/>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/llImagesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageView
                android:id="@+id/ivLargeImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:visibility="gone" />


        </LinearLayout>



    </FrameLayout>


</ScrollView>