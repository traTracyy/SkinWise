<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="90dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".User.UHisDetails">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/Rlayout2"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                >

                <ImageButton
                    android:id="@+id/backbtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="30dp"
                    android:layout_centerVertical="true"
                    android:background="@null"
                    android:src="@drawable/ic_back"/>
                <TextView
                    android:id="@+id/bacttxt"
                    android:textColor="@color/darker"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:layout_alignStart="@+id/backbtn"
                    android:text="@string/Back"/>

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:id="@+id/deletehistory"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="110dp"
                android:layout_height="wrap_content">
                <ImageButton
                    android:background="@null"
                    android:layout_width="35dp"
                    android:layout_toStartOf="@+id/filtertxt"
                    android:layout_height="35dp"
                    android:scaleType="fitXY"
                    android:id="@+id/bookmarkic"
                    android:src="@drawable/ic_remove_history" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_toEndOf="@id/bookmarkic"
                    android:text="Remove History"
                    android:textColor="@color/darker"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_gravity="center_horizontal"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/_30sdp"
            android:textColor="@color/darker"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="The results are not 100% accurate, please consult a specialist if necessary."/>

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="200dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:src="@drawable/round_corner2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/Date"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:text="Date:"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/datetv"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="italic"
                android:text="date" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:text="Time:"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timetv"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_gravity="center"
                android:textStyle="italic"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="Time" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/lesion_type_text"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:text="Skin Lesion Type:\t"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lesion_type"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_gravity="center"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="Type" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_height="wrap_content"
                android:text="Age: "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/agetxt"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_height="wrap_content"
                android:text="Age"
                android:textSize="15sp"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_height="wrap_content"
                android:text="Location: "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/locationtxt"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="15sp"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gender"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_height="wrap_content"
                android:text="Gender: "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gendertxt"
                android:layout_width="wrap_content"
                android:textColor="@color/darker"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:textSize="15sp"/>

        </LinearLayout>
        <TextView
            android:id="@+id/confidence_text"
            android:layout_width="wrap_content"
            android:textColor="@color/white"
            android:background="@color/darker"
            android:layout_height="wrap_content"
            android:text="\t\tConfidence Levels\t\t"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"
            android:layout_gravity="center_horizontal"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/confidence_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/Melanomatxt"
                    android:layout_width="240dp"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:text="Melanoma:"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/Melanoma"
                    android:textColor="@color/darker"
                    android:textAlignment="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confidence"
                    android:textSize="18sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/MVtxt"
                    android:layout_width="240dp"
                    android:textAlignment="textEnd"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Melanocytic Nevus:"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/MV"
                    android:layout_width="match_parent"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Confidence"
                    android:textSize="18sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/BCCtxt"
                    android:layout_width="240dp"
                    android:textAlignment="textEnd"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Basal Cell Carcinoma:"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/BCC"
                    android:layout_width="match_parent"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Confidence"
                    android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/AKtxt"
                    android:layout_width="240dp"
                    android:textAlignment="textEnd"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Actinic Keratosis:"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/AK"
                    android:layout_width="match_parent"
                    android:textColor="@color/darker"
                    android:textAlignment="center"
                    android:layout_height="wrap_content"
                    android:text="Confidence"
                    android:textSize="18sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/BKtxt"
                    android:layout_width="240dp"
                    android:textColor="@color/darker"
                    android:textAlignment="textEnd"
                    android:layout_height="wrap_content"
                    android:text="Benign Keratosis:"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/BK"
                    android:layout_width="match_parent"
                    android:textAlignment="center"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Confidence"
                    android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/DFtxt"
                    android:textAlignment="textEnd"
                    android:layout_width="240dp"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Dermatofibroma:"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/DF"
                    android:layout_width="match_parent"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Confidence"
                    android:textSize="18sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/VLtxt"
                    android:layout_width="240dp"
                    android:textAlignment="textEnd"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Vascular Lesion:"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/VL"
                    android:layout_width="match_parent"
                    android:textAlignment="center"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Confidence"
                    android:textSize="18sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/SCCtxt"
                    android:layout_width="240dp"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Squamous Cell Carcinoma:"
                    android:textAlignment="textEnd"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/SCC"
                    android:layout_width="match_parent"
                    android:textColor="@color/darker"
                    android:layout_height="wrap_content"
                    android:text="Confidence"
                    android:textAlignment="center"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>
    </FrameLayout>

</ScrollView>