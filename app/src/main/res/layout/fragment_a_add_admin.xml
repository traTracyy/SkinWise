<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_marginBottom="90dp"
    android:layout_height="match_parent"
    tools:context=".Admin.AAddAdmin">


    <RelativeLayout
        android:id="@+id/Rlayout2"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="20dp">

        <ImageButton
            android:id="@+id/backbtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="30dp"
            android:layout_centerVertical="true"
            android:background="@null"
            android:src="@drawable/ic_back"/>
        <TextView
            android:id="@+id/bacttxt"
            android:textColor="@color/darker"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_centerVertical="true"
            android:layout_alignStart="@+id/backbtn"
            android:text="@string/Back"/>

    </RelativeLayout>


    <RelativeLayout
        android:background="@drawable/shape_border_round"
        app:backgroundTint="@null"
        android:padding="25dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:id="@+id/loginR1">

        <com.blogspot.atifsoftwares.circularimageview.CircularImageView
            android:id="@+id/profile"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerHorizontal="true"
            android:src="@drawable/ic_profile"
            app:c_border="true"
            app:c_border_color="@color/darker"
            app:c_border_width="1dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content"
            android:layout_below="@+id/profile"
            android:layout_marginTop="5dp"
            android:textColor="@color/darker"
            android:textSize="12dp"
            android:text="Upload Profile Image"/>

        <EditText
            android:id="@+id/namehint"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:layout_marginTop="45dp"
            android:drawableStart="@drawable/ic_name"
            android:drawablePadding="15dp"
            android:layout_below="@+id/profile"
            android:hint="@string/namehint"
            android:textColorHint="@color/darker"
            android:textColor="@color/darker"
            android:textSize="12dp"
            android:inputType="textPersonName|textCapWords"
            android:padding="8dp" />

        <EditText
            android:id="@+id/addresshint"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/namehint"
            android:layout_marginTop="15dp"
            android:background="@drawable/round_corner3"
            android:textSize="12dp"
            android:drawableStart="@drawable/ic_location"
            android:drawablePadding="15dp"
            android:hint="@string/locationhint"
            android:padding="8dp"
            android:textColor="@color/darker"
            android:textColorHint="@color/darker"
            android:focusable="true"
            android:clickable="true"
            android:inputType="none"
            android:editable="false"  />

        <EditText
            android:id="@+id/emailhint"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:drawableStart="@drawable/ic_email"
            android:textSize="12dp"
            android:drawablePadding="15dp"
            android:textColorHint="@color/darker"
            android:textColor="@color/darker"
            android:layout_marginTop="15dp"
            android:hint="@string/emailhint"
            android:layout_below="@+id/phonenumberhint"
            android:inputType="textEmailAddress"
            android:padding="8dp" />

        <EditText
            android:id="@+id/phonenumberhint"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textSize="12dp"
            android:background="@drawable/round_corner3"
            android:drawableStart="@drawable/ic_phonenumber"
            android:drawablePadding="15dp"
            android:layout_marginTop="15dp"
            android:hint="@string/pnhint"
            android:textColorHint="@color/darker"
            android:textColor="@color/darker"
            android:layout_below="@+id/addresshint"
            android:inputType="phone"
            android:padding="8dp" />

        <EditText
            android:id="@+id/passwordhint"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:textSize="12dp"
            android:drawableStart="@drawable/ic_locker"
            android:drawablePadding="15dp"
            android:layout_marginTop="15dp"
            android:textColorHint="@color/darker"
            android:textColor="@color/darker"
            android:hint="@string/passwordhint"
            android:layout_below="@+id/emailhint"
            android:inputType="textPassword"
            android:padding="8dp" />

        <EditText
            android:id="@+id/passwordhint2"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:drawableStart="@drawable/ic_password"
            android:drawablePadding="15dp"
            android:layout_marginTop="15dp"
            android:textSize="12dp"
            android:textColorHint="@color/darker"
            android:textColor="@color/darker"
            android:hint="@string/passwordhint2"
            android:layout_below="@+id/passwordhint"
            android:inputType="textPassword"
            android:padding="8dp" />

        <Button
            android:id="@+id/registerbtn1"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_cornerlighter"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/passwordhint2"
            android:layout_marginTop="15dp"
            app:backgroundTint="@null"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:text="@string/Register"/>


    </RelativeLayout>

</FrameLayout>