<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Dermatologist.DChangePassword">

    <RelativeLayout
        android:id="@+id/Rlayout2"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        >

        <ImageButton
            android:id="@+id/backbtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="30dp"
            android:layout_centerVertical="true"
            android:background="@null"
            android:src="@drawable/ic_back"/>
        <TextView
            android:id="@+id/bacttxt"
            android:textColor="@color/darker"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_centerVertical="true"
            android:layout_alignStart="@+id/backbtn"
            android:text="@string/Back"/>

    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="120dp"
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="@color/darker"
        android:text="Change Password"/>
    <RelativeLayout
        android:id="@+id/RLayout1"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/Originalpassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="Original Password: "
            android:textColor="@color/darker" />

        <EditText
            android:id="@+id/passwordhint"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:textSize="12dp"
            android:drawableStart="@drawable/ic_locker"
            android:drawablePadding="15dp"
            android:layout_marginTop="15dp"
            android:textColorHint="@color/darker"
            android:textColor="@color/darker"
            android:hint="@string/passwordhint3"
            android:layout_below="@+id/Originalpassword"
            android:inputType="textPassword"
            android:padding="8dp" />
        <TextView
            android:id="@+id/password1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:text="New Password: "
            android:layout_below="@id/passwordhint"
            android:textColor="@color/darker" />

        <EditText
            android:id="@+id/passwordhint1"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:textSize="12dp"
            android:drawableStart="@drawable/ic_locker"
            android:drawablePadding="15dp"
            android:layout_marginTop="15dp"
            android:textColorHint="@color/darker"
            android:textColor="@color/darker"
            android:hint="@string/passwordhint"
            android:layout_below="@+id/password1"
            android:inputType="textPassword"
            android:padding="8dp" />

        <TextView
            android:id="@+id/password2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:text="Confirm Password: "
            android:layout_below="@id/passwordhint1"
            android:textColor="@color/darker" />
        <EditText
            android:id="@+id/passwordhint2"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner3"
            android:drawableStart="@drawable/ic_password"
            android:drawablePadding="15dp"
            android:layout_marginTop="15dp"
            android:textSize="12dp"
            android:textColorHint="@color/darker"
            android:textColor="@color/darker"
            android:hint="@string/passwordhint2"
            android:layout_below="@+id/password2"
            android:inputType="textPassword"
            android:padding="8dp" />

        <Button
            android:id="@+id/chnagepassowrdbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/round_cornerlighter"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/passwordhint2"
            android:layout_marginTop="35dp"
            app:backgroundTint="@null"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:text="@string/ChangePassword"/>

    </RelativeLayout>

</FrameLayout>